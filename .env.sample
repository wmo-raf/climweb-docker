######### DATABASE ENV BEGIN #########
CMS_DB_USER=
CMS_DB_NAME=
CMS_DB_PASSWORD=
CMS_DB_VOLUME=./climweb/db-data
######### DATABASE ENV END #########

######### CMS ENV BEGIN #########
#CHECK LATEST RELEASE AT https://github.com/wmo-raf/nmhs-cms/releases
CLIMWEB_VERSION=1.1.6
CMS_DEBUG=False
CMS_SITE_NAME=
CMS_ADMIN_URL_PATH=cms-admin
TIME_ZONE=UTC
SECRET_KEY=""      # SHOULD NOT BE LESS THAN 50 characters. Mix numbers and letters and symbols
ALLOWED_HOSTS="<ip_or_domain>," # UPDATE ME
CSRF_TRUSTED_ORIGINS="http://<ip_or_domain>" # UPDATE ME
CMS_PORT=80
CMS_BASE_URL="http://<ip_or_domain>" # UPDATE ME

# default language. available codes are:
# en for English, default if not set
# fr for French
# ar for Arabic
# am for Amharic
# es for Spanish
# sw for Swahili
CMS_DEFAULT_LANGUAGE_CODE="en"

#BACKUP MECHANISM
BACKUP_VOLUME=./climweb/backup

# Geomanager auto-ingest data directory
GEOMANAGER_AUTO_INGEST_DATA_VOLUME=./climweb/geomanager-data

# CMS Email settings
SMTP_EMAIL_HOST=
SMTP_EMAIL_PORT=
SMTP_EMAIL_USE_TLS=
SMTP_EMAIL_HOST_USER=
SMTP_EMAIL_HOST_PASSWORD=
CMS_ADMINS=
DEFAULT_FROM_EMAIL=

# Google Recaptcha settings for forms
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
RECAPTCHA_DOMAIN=www.google.com
RECAPTCHA_VERIFY_REQUEST_TIMEOUT=60
# num of workers recommended as (2 x $num_cores) + 1. See https://docs.gunicorn.org/en/latest/design.html#how-many-workers
CMS_NUM_OF_WORKERS=4
# docker volumes for django static and media files
CMS_STATIC_VOLUME=./climweb/static
CMS_MEDIA_VOLUME=./climweb/media
CLIMWEB_PLUGIN_VOLUME=./climweb/plugins


CMS_UPGRADE_HOOK_URL=http://host.docker.internal:9000/hooks/cms-upgrade

# Webhook URL for plugin removal, triggered from the Wagtail admin Plugins page.
# Set to: http://host.docker.internal:9000/hooks/plugin-remove
CMS_PLUGIN_MANAGE_HOOK_URL=http://host.docker.internal:9000/hooks/plugin-remove
# Comma-separated list of plugin git repository URLs to install on container start.
# To install a plugin: add its repo URL here and restart the containers.
# To remove a plugin: remove its URL here and restart the containers.
# To update a plugin: restart the containers (the latest commit is pulled on each start).
# Example: CLIMWEB_PLUGIN_GIT_REPOS=https://github.com/org/plugin-a,https://github.com/org/plugin-b
CLIMWEB_PLUGIN_GIT_REPOS=

# URL used by the upgrade script to health-check the app after restarting.
# Defaults to http://localhost:<CMS_PORT>/api/_health/ if not set.
CMS_HEALTHCHECK_URL=

LETSENCRYPT_VOLUME=

CAP_PRIVATE_KEY_PATH=
CAP_CERT_PATH=
CAP_SIGNATURE_METHOD="ECDSA_SHA256"
######### CMS ENV END #########

######### MAPVIEWER ENV BEGIN #########
MAPVIEWER_CMS_API="http://<ip_or_domain>/api" # UPDATE ME 
MAPVIEWER_BASE_PATH=""
MAPVIEWER_ASSET_PREFIX=""
ANALYTICS_PROPERTY_ID=""
BITLY_TOKEN=""
GOOGLE_CUSTOM_SEARCH_CX=""
GOOGLE_SEARCH_API_KEY=""
MAPVIEWER_NEXT_STATIC_VOLUME=./mapviewer/.next/static
######### MAPVIEWER ENV END #########

WAGTAIL_2FA_REQUIRED=False
CLIMWEB_ENABLE_OTEL=
HONEYCOMB_API_KEY=

CLIMWEB_ADDITIONAL_APPS=""



# UID/GID must match the user the climweb image was built with.
# To check: docker run --rm --entrypoint="" ghcr.io/wmo-raf/climweb:v<version> id climweb_docker_user
# As of climweb v1.0.9+, the correct value is 1001.
UID=1001
GID=1001

IS_METEOROLOGICAL=True
